---
import '../styles/global.css';
import site from '../data/site.json';

const { hero, beneficios, prova, comoFunciona, oferta, preco, faq, garantias, formulario, final, rodape } = site;
const delay = (i: number) => (i === 0 ? '' : ` reveal-delay-${i}`);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{site.seo.titulo}</title>
<meta name="description" content={site.seo.descricao}>
</head>
<body class="no-js">

<header id="top">
  <div class="container">
    <a class="logo" href="#inicio" aria-label="Papelaria Renata, início">Papelaria <span>Renata</span></a>
    <a class="btn btn-primary btn-sm" href="#pedido">{site.cta}</a>
  </div>
</header>

<main>
<!-- 1. HERO -->
<section class="hero" id="inicio">
  <div class="container">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="heading-xl">{hero.tituloAntes} <em>{hero.tituloDestaque}</em></h1>
      <p class="hero-sub">{hero.subtitulo}</p>
      <a class="btn btn-primary" href="#pedido">{site.cta}</a>
      <p class="small hero-micro">{hero.micro}</p>
      <div class="facts">
        {hero.fatos.map((f) => <div><strong>{f.numero}</strong><span class="small">{f.texto}</span></div>)}
      </div>
    </div>
    <figure class="hero-art">
      <img src={hero.imagem} width="640" height="800" alt={hero.imagemAlt} loading="eager" fetchpriority="high" decoding="async">
      <figcaption class="small">{hero.imagemLegenda}</figcaption>
    </figure>
  </div>
</section>

<!-- 2. BENEFÍCIOS -->
<section class="section below" aria-labelledby="t-beneficios">
  <div class="container">
    <h2 id="t-beneficios" class="reveal">{beneficios.titulo}</h2>
    <p class="lead reveal">{beneficios.lead}</p>
    <div class="cols">
      {beneficios.cards.map((c, i) => (
        <div class={`card reveal${delay(i)}`}><div class="num">{c.numero}</div><h3>{c.titulo}</h3><p>{c.texto}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- 3. PROVA SOCIAL -->
<section class="section section-soft below" aria-labelledby="t-prova">
  <div class="container">
    <h2 id="t-prova" class="reveal">{prova.titulo}</h2>
    <p class="lead reveal">{prova.lead}</p>
    <div class="proof">
      <ul class="reveal">
        {prova.fatos.map((f) => <li><strong>{f.numero}</strong><span>{f.texto}</span></li>)}
      </ul>
      <div class="reveal reveal-delay-1" style="flex:1;display:flex;flex-direction:column;gap:16px">
        <figure style="margin:0">
          <img src={prova.foto} alt={prova.fotoAlt} width="1280" height="720" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius-md);display:block">
          <figcaption class="small" style="margin-top:6px;color:var(--color-text-light)">{prova.fotoLegenda}</figcaption>
        </figure>
        <blockquote class="quote" style="margin:0"><p>“{prova.depoimento.texto}”</p><p class="small" style="margin-top:8px"><strong>{prova.depoimento.autor}</strong></p></blockquote>
      </div>
    </div>
  </div>
</section>

<!-- 4. COMO FUNCIONA -->
<section class="section below" aria-labelledby="t-como">
  <div class="container">
    <h2 id="t-como" class="reveal">{comoFunciona.titulo}</h2>
    <p class="lead reveal">{comoFunciona.lead}</p>
    <div class="cols">
      {comoFunciona.passos.map((p, i) => (
        <div class={`card step reveal${delay(i)}`}><div class="big">{i + 1}</div><div><h3>{p.titulo}</h3><p>{p.texto}</p><span class="time">{p.tempo}</span></div></div>
      ))}
    </div>
  </div>
</section>

<!-- 5. OFERTA E DIFERENCIAIS -->
<section class="section section-soft below" aria-labelledby="t-oferta">
  <div class="container">
    <h2 id="t-oferta" class="reveal">{oferta.titulo}</h2>
    <p class="lead reveal">{oferta.lead}</p>
    <div class="offer">
      <div class="kit reveal">
        <h3>{oferta.kitTitulo}</h3>
        <ul>
          {oferta.kitItens.map((k) => <li><strong>{k.qtd}</strong> {k.texto}</li>)}
        </ul>
      </div>
      <div class="cols reveal reveal-delay-1" style="flex:1;flex-direction:column;margin-top:0">
        {oferta.diferenciais.map((d) => <div class="card"><h3>{d.titulo}</h3><p>{d.texto}</p></div>)}
      </div>
    </div>
  </div>
</section>

<!-- 6. PLANOS E PREÇOS -->
<section class="section below" aria-labelledby="t-preco">
  <div class="container">
    <h2 id="t-preco" class="reveal" style="text-align:center">{preco.titulo}</h2>
    <div class="price reveal">
      <p class="small">{preco.plano}</p>
      <p class="value">{preco.valor}</p>
      <p class="small">{preco.detalhe}</p>
      <ul>
        {preco.itens.map((it) => <li><strong>{it.qtd}</strong> {it.texto}</li>)}
      </ul>
      <a class="btn btn-primary" href="#pedido">{site.cta}</a>
    </div>
  </div>
</section>

<!-- 7. FAQ -->
<section class="section section-soft below" aria-labelledby="t-faq">
  <div class="container">
    <h2 id="t-faq" class="reveal">{faq.titulo}</h2>
    <div class="faq">
      {faq.itens.map((f, i) => (
        <div class={i === 0 ? 'faq-item active' : 'faq-item'}>
          <button class="faq-question" aria-expanded={i === 0 ? 'true' : 'false'}>{f.pergunta}</button>
          <div class="faq-answer"><div><p>{f.resposta}</p></div></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 8. GARANTIAS -->
<section class="section below" aria-labelledby="t-garantias">
  <div class="container">
    <h2 id="t-garantias" class="reveal">{garantias.titulo}</h2>
    <ul class="guarantees">
      {garantias.itens.map((g, i) => (
        <li class={`reveal${delay(i)}`}><span class="check" aria-hidden="true">✓</span><span><strong>{g.titulo}</strong><br><span class="small">{g.texto}</span></span></li>
      ))}
    </ul>
  </div>
</section>

<!-- 9. FORMULÁRIO -->
<section class="section section-soft below" id="pedido" aria-labelledby="t-form">
  <div class="container">
    <h2 id="t-form">{formulario.titulo}</h2>
    <p class="lead">{formulario.lead}</p>
    <form id="form-pedido" action="#pedido" method="get">
      <div><label for="nome">Seu nome</label><input id="nome" name="nome" type="text" autocomplete="name" required></div>
      <div><label for="tel">WhatsApp</label><input id="tel" name="tel" type="tel" autocomplete="tel" placeholder="(11) 90000-0000" required></div>
      <div><label for="data">Data da festa</label><input id="data" name="data" type="date" required></div>
      <div><label for="tema">Tema e cor da festa</label><input id="tema" name="tema" type="text" placeholder="Ex.: Safari, verde e bege" required></div>
      <label class="lgpd"><input type="checkbox" required> {formulario.lgpd}</label>
      <button class="btn btn-primary" type="submit">{site.cta}</button>
    </form>
    <div id="confirmacao" tabindex="-1" class="confirm" role="status" aria-live="polite" hidden>
      <span class="check" aria-hidden="true">✓</span>
      <div><h3>{formulario.confirmacaoTitulo}</h3><p>Obrigada, <strong id="conf-nome"></strong>. {formulario.confirmacaoTexto}</p></div>
    </div>
  </div>
</section>

<!-- 10. CTA FINAL -->
<section class="section final below" aria-labelledby="t-final">
  <div class="container">
    <h2 id="t-final" class="reveal">{final.titulo}</h2>
    <p class="lead reveal">{final.lead}</p>
    <a class="btn btn-primary reveal" href="#pedido">{site.cta}</a>
    <p class="small">{final.micro}</p>
  </div>
</section>
</main>

<!-- 11. RODAPÉ -->
<footer>
  <div class="container">
    <div class="cols">
      <div><h3>Papelaria Renata</h3><p>{rodape.descricao}</p></div>
      <div><h3>Atendimento</h3><p>WhatsApp: <a href={`https://wa.me/${rodape.whatsappNumero}`} target="_blank" rel="noopener">{rodape.whatsapp}</a><br>Endereço da loja: {rodape.endereco}</p></div>
      <div><h3>Privacidade</h3><p>{rodape.privacidade}</p></div>
    </div>
    <p class="legal">{rodape.legal}</p>
  </div>
</footer>

<script is:inline>
document.body.classList.remove('no-js');document.body.classList.add('js');
(function(){
  var els=document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('active')});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(en){if(en.isIntersecting){en.target.classList.add('active');io.unobserve(en.target);}});},{threshold:.1,rootMargin:'0px 0px -50px 0px'});
  els.forEach(function(e){io.observe(e);e.addEventListener('transitionend',function(){this.style.willChange='auto'},{once:true});});
})();
document.querySelector('.faq').addEventListener('click',function(ev){
  var btn=ev.target.closest('.faq-question');if(!btn)return;
  var item=btn.parentElement,open=item.classList.contains('active');
  this.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('active');i.firstElementChild.setAttribute('aria-expanded','false');});
  if(!open){item.classList.add('active');btn.setAttribute('aria-expanded','true');}
});
(function(){
  var h=document.getElementById('top'),last=0;
  window.addEventListener('scroll',function(){var y=window.scrollY;h.classList.toggle('hide',y>last&&y>200);last=y;},{passive:true});
})();
document.getElementById('form-pedido').addEventListener('submit',function(ev){
  ev.preventDefault();
  var c=document.getElementById('confirmacao');
  document.getElementById('conf-nome').textContent=this.nome.value.split(' ')[0];
  this.hidden=true;c.hidden=false;c.focus();
});
</script>
</body>
</html>
